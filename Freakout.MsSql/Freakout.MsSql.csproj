<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(FreakoutLibraryTargetFrameworks)</TargetFrameworks>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/rebus-org/Freakout</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageIcon>transparent_2024-04-11T18-52-17_cropped.png</PackageIcon>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\artwork\transparent_2024-04-11T18-52-17_cropped.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="microsoft.data.sqlclient" Version="6.0.2" />
		<PackageReference Include="sequentialguid" Version="4.0.6" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Freakout\Freakout.csproj" />
	</ItemGroup>

</Project>
